<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>FAQ Takeover Prototype</title>
<style>
html,body{margin:0;height:100%;background:#111;overflow:hidden;font-family:Arial,sans-serif}
body.locked,body.locked *{cursor:none!important}
#wrap{position:absolute;left:50%;top:50%;width:1265px;height:883px;transform:translate(-50%,-50%) scale(var(--s,1));transform-origin:center;background:#f4f0e7;overflow:hidden}
#shot{position:absolute;inset:0;width:100%;height:100%}
.patch{position:absolute;background:#f4f0e7;color:#26384a;z-index:3}
#p1{left:69px;top:128px;width:575px;height:58px;padding:6px 4px}
#p2{left:118px;top:707px;width:610px;height:40px;padding:1px 3px}
#title{font:700 39px/1 Georgia,serif;letter-spacing:-.7px;white-space:nowrap}
#docs{font:700 23px/1.2 Georgia,serif;white-space:nowrap}
.c{display:inline-block}
.c.x{animation:flick .32s steps(2,end) forwards}
.c.gone{opacity:0}
@keyframes flick{0%{opacity:1}25%{opacity:.15;transform:translateX(-3px) skewX(-12deg)}45%{opacity:1;transform:translateX(3px)}70%{opacity:.1;transform:translateY(-2px) scaleY(1.3)}100%{opacity:0;transform:scale(.2)}}

#modal{position:absolute;z-index:20;left:50%;top:50%;transform:translate(-50%,-50%);width:390px;padding:28px;background:#fff;border-radius:18px;box-shadow:0 20px 60px #0003;text-align:center;border:1px solid #26384a22}
#modal h2{margin:0 0 10px;font:700 28px Georgia,serif;color:#26384a}
#modal p{margin:0 0 20px;color:#6a746f;font-size:14px}
button{border:0;border-radius:10px;padding:10px 18px;font-weight:800;font-size:12px;letter-spacing:.06em}
#close,#ok{background:#879887;color:#fff}
#skip{background:#eee9e1;color:#59645e}
#skip.off{background:#ddd8d0;color:#aaa;text-decoration:line-through;pointer-events:none}
#close{position:fixed;z-index:22}
.actions{display:flex;gap:10px;justify-content:center}

#term{position:absolute;z-index:12;left:690px;top:390px;width:430px;background:#172027;color:#edf3ef;border:1px solid #27333a;border-radius:9px;box-shadow:0 18px 50px #0005;overflow:hidden;opacity:0;transform:scale(.95) translateY(8px);transition:.2s;font:14px/1.7 Consolas,monospace}
#term.show{opacity:1;transform:none}
.bar{height:31px;background:#27333a;color:#b9c3be;padding:7px 12px;font-size:12px}
#termText{padding:18px;min-height:165px;white-space:pre-line}
#done{display:none;font-weight:700}
#done.flash{display:block;animation:blink .22s steps(1,end) infinite}
@keyframes blink{50%{opacity:.06}}

#noise{position:absolute;inset:0;z-index:10;pointer-events:none;opacity:0;background:repeating-linear-gradient(0deg,#fff1 0 1px,#0001 2px 4px)}
#tear{position:absolute;z-index:11;left:0;top:315px;width:100%;height:74px;opacity:0;background-image:url(data:image/png;base64,);background-size:1265px 883px;background-position:0 -315px}
.glitch #shot,.glitch .patch{animation:jitter .14s steps(2,end) infinite}
.glitch #term{animation:jitter2 .17s steps(2,end) infinite}
.glitch #noise{opacity:1;animation:nz .15s steps(2,end) infinite}
.glitch #tear{opacity:.9;animation:tear .11s steps(2,end) infinite}
@keyframes jitter{25%{transform:translate(-4px,1px);filter:hue-rotate(20deg) contrast(1.2)}50%{transform:translate(3px,-2px)}75%{transform:translate(-2px,2px);filter:hue-rotate(-20deg)}}
@keyframes jitter2{35%{transform:translate(3px,-1px)}70%{transform:translate(-4px,2px)}}
@keyframes nz{50%{opacity:.75}}
@keyframes tear{50%{transform:translateX(-30px)}100%{transform:translateX(12px)}}

#black{position:absolute;inset:0;z-index:40;background:#000;opacity:0;display:flex;align-items:center;justify-content:center;transition:opacity .12s}
#black.on{opacity:1}
#bday{color:#fff;font:700 68px/1.02 Georgia,serif;text-align:center;opacity:0}
#bday.show{animation:slam .55s cubic-bezier(.15,.85,.2,1) forwards}
@keyframes slam{0%{opacity:0;transform:scale(2.3);filter:blur(10px)}55%{opacity:1;transform:scale(.9);filter:none}100%{opacity:1;transform:scale(1)}}

#replay{position:fixed;right:15px;bottom:15px;z-index:80;background:#fff;color:#26384a;box-shadow:0 5px 20px #0004}
</style>
</head>
<body>
<div id="wrap">
<img id="shot" src="data:image/png;base64,">
<div id="p1" class="patch"><div id="title"></div></div>
<div id="p2" class="patch"><div id="docs"></div></div>

<div id="modal">
  <h2 id="mt">sorry.</h2>
  <p id="mc">I need one second.</p>
  <div class="actions">
    <button id="skip" style="display:none">SKIP</button>
    <button id="ok" style="display:none">OK</button>
  </div>
</div>
<button id="close">CLOSE</button>

<div id="term"><div class="bar">system</div><div id="termText"><span id="tb"></span><span id="done">&gt; done.</span></div></div>
<div id="noise"></div><div id="tear"></div>
<div id="black"><div id="bday">HAPPY<br>BIRTHDAY<br>DAVIS</div></div>
</div>
<button id="replay">Replay demo</button>

<script>
const q=s=>document.querySelector(s),wrap=q('#wrap'),modal=q('#modal'),close=q('#close'),skip=q('#skip'),ok=q('#ok'),term=q('#term'),tb=q('#tb'),done=q('#done'),black=q('#black'),bday=q('#bday');
let step=0,running=false,timers=[];
const later=(f,m)=>{let id=setTimeout(f,m);timers.push(id);return id}
function fit(){wrap.style.setProperty('--s',Math.min(innerWidth/1265,innerHeight/883))}
addEventListener('resize',fit);fit();

function spans(el,text){el.innerHTML='';[...text].forEach((ch,i)=>{let s=document.createElement('span');s.className='c';s.dataset.i=i;s.textContent=ch===' '?'\u00a0':ch;el.appendChild(s)})}
function rebuild(){spans(q('#title'),'Frequently Asked Questions');spans(q('#docs'),'Documents, phones, insurance + money')}
function center(){let r=wrap.getBoundingClientRect();close.style.left=(r.left+r.width/2-close.offsetWidth/2)+'px';close.style.top=(r.top+r.height/2+78)+'px'}
function move(){let r=wrap.getBoundingClientRect(),m=65;close.style.left=(r.left+m+Math.random()*(r.width-close.offsetWidth-m*2))+'px';close.style.top=(r.top+m+Math.random()*(r.height-close.offsetHeight-m*2))+'px'}
function copy(t,c){q('#mt').textContent=t;q('#mc').textContent=c}

function chase(){
 if(running)return; step++;
 if(step===1){copy("I appreciate everyone's patience.","Almost done.");move()}
 else if(step===2){copy("but...","one small thing first.");move()}
 else{close.style.display='none';copy("I'm going to hijack this presentation for a minute...","This should only take a second.");skip.style.display='';ok.style.display=''}
}
close.addEventListener('pointerenter',chase);close.addEventListener('click',chase);
skip.onclick=()=>skip.classList.add('off');
ok.onclick=()=>{if(running)return;running=true;document.body.classList.add('locked');modal.style.display='none';sequence()}

function steal(el){
 if(!el)return;el.classList.add('x');later(()=>{el.classList.add('gone');el.classList.remove('x')},300)
}
function fastSteal(){
 let a=[...q('#title').children,...q('#docs').children].filter(x=>x.textContent.trim()&&!x.classList.contains('gone')),n=0;
 let id=setInterval(()=>{if(n++>12){clearInterval(id);finish();return}let x=a.splice(Math.floor(Math.random()*a.length),1)[0];if(x)steal(x)},100)
}
function sequence(){
 term.classList.add('show');tb.textContent='> locating usable characters...';
 later(()=>tb.textContent='> locating usable characters...\n\n> characters located.\n\n> extracting...',900);
 later(()=>{let title=[...q('#title').children];steal(title[11])},1500); // A in Asked
 later(()=>steal(q('#docs').children[0]),2150); // D in Documents
 later(fastSteal,2600)
}
function finish(){
 tb.textContent='> locating usable characters...\n\n> characters located.\n\n> extracting... 100%\n';
 done.classList.add('flash');
 later(()=>wrap.classList.add('glitch'),450);
 later(()=>black.classList.add('on'),2200);
 later(()=>bday.classList.add('show'),3000);
 later(reset,6500)
}
function reset(){
 timers.forEach(clearTimeout);timers=[];step=0;running=false;document.body.classList.remove('locked');wrap.classList.remove('glitch');term.classList.remove('show');tb.textContent='';done.classList.remove('flash');black.classList.remove('on');bday.classList.remove('show');modal.style.display='';skip.style.display='none';ok.style.display='none';skip.classList.remove('off');close.style.display='';copy('sorry.','I need one second.');rebuild();later(center,50)
}
q('#replay').onclick=reset;
rebuild();later(center,80);
</script>
</body>
</html>
